# Copy the names into Vercel (Project → Settings → Environment Variables). Never commit real values.

# Claude access: either an MIT Parley key (used when set) or an Anthropic API key.
# Mark keys "Sensitive" in Vercel. Server-only: never prefix with NEXT_PUBLIC_.
PARLEY_API_KEY=
PARLEY_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Optional: last day the key is valid (YYYY-MM-DD), to show a renewal notice the week before.
# Leave it out for a key that never expires. Public: only used for the notice.
NEXT_PUBLIC_API_KEY_EXPIRES=

# Neon Postgres connection string (set automatically when Neon is added from Vercel's Storage tab).
DATABASE_URL=

# Login: hash of your passcode (npx tsx scripts/hash-passcode.ts) and a random signing secret
# (openssl rand -base64 32). Mark both "Sensitive".
APP_PASSCODE_HASH=
SESSION_SECRET=

# Optional: chat model override (defaults to claude-haiku-5-5).
# CHAT_MODEL=
